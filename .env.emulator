# Configuración para `npm run dev:emu`: usa el Emulator Suite local con un
# proyecto "demo-" (no requiere proyecto real ni credenciales).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nutricion.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nutricion
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
